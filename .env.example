# ===========================================
# PROMPT DATABASE — ENVIRONMENT VARIABLES
# ===========================================
# ⚠️  NO HAY ENTORNO LOCAL DE DESARROLLO.
# Todo el desarrollo se ejecuta directamente en PRODUCTION
# (Vercel + Neon.tech PostgreSQL).
#
# Las variables de producción se configuran en Vercel Dashboard:
#   Vercel → Project → Settings → Environment Variables
#
# Este archivo .env.example es solo referencia de las variables
# que Vercel provee automáticamente.
# NO pongas valores reales aquí — este archivo se versiona.
# ===========================================

# ═══════════════════════════════════════════════
# PRODUCTION — Neon.tech PostgreSQL + Vercel
# ═══════════════════════════════════════════════
# Estas variables las provee o configura Vercel.
# ═══════════════════════════════════════════════

# Database (Neon.tech) — configurar en Vercel Dashboard
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require"

# Auth (producción)
# AUTH_SECRET="your-prod-auth-secret"   # Generar con: openssl rand -base64 32
# AUTH_URL="https://prompt-database-liard.vercel.app"

# Vercel (se asignan automáticamente en despliegue)
# VERCEL="1"
# VERCEL_ENV="production"
# VERCEL_URL="prompt-database-liard.vercel.app"

# VERCEL OIDC Token (se genera automáticamente en vercel link)
# VERCEL_OIDC_TOKEN="your-vercel-oidc-token"

# VERCEL_TOKEN (para deploy CLI)
# Generar en: Vercel Dashboard > Account > Tokens (cuenta personal, NO team)
# Se pasa como env var: VERCEL_TOKEN="vcp_..." vercel deploy --prod
# (NO usar --token flag — no funciona con tokens de cuenta personal)
